{
    "data_dir": "data",
    "fetcher": {
        "type": "apple",
        "filter_health_only": false,
        "default_limit": 100,
        "country": "us",
        "genre": null
    },
    "podchaser": {
        "client_id": "YOUR_PODCHASER_CLIENT_ID",
        "client_secret": "YOUR_PODCHASER_CLIENT_SECRET",
        "api_url": "https://api.podchaser.com/graphql"
    },
    "spotify": {
        "chart_url": "https://podcastcharts.byspotify.com/api/charts/top-podcasts",
        "match_candidates": 10,
        "search_delay_seconds": 6.0,
        "search_attempts": 5
    },
    "discovery": {
        "max_episodes_per_podcast": 5000,
        "max_parallel_feeds": 8,
        "feed_timeout_seconds": 60
    },
    "download": {
        "max_workers": 8,
        "timeout_seconds": 600,
        "min_free_gb": 100
    },
    "audio_compression": {
        "enabled": true,
        "size_threshold_mb": 50,
        "bitrate": "24k",
        "keep_original": false
    },
    "transcription": {
        "backend": "parakeet",
        "model_name": "nvidia/parakeet-tdt-0.6b-v2",
        "gpu_ids": [
            0
        ],
        "batch_size": 1,
        "chunk_duration_seconds": 300,
        "overlap_seconds": 30,
        "vad_enabled": false,
        "vad_threshold": 0.5,
        "vad_min_speech_duration_ms": 250,
        "vad_min_silence_duration_ms": 2000,
        "vad_speech_pad_ms": 30,
        "use_cuda_graphs": true,
        "isolated_gpu_workers": false,
        "decode_workers": 0,
        "decode_prefetch": 8,
        "vllm_urls": [
            "http://127.0.0.1:8100"
        ],
        "vllm_request_concurrency": 32,
        "vllm_language": "en",
        "vllm_timeout_seconds": 1800,
        "vllm_max_completion_tokens": null,
        "vllm_audio_remux_cache_dir": null
    },
    "storage": {
        "transcript_compression_level": 3
    },
    "batch_export": {
        "target_size_gb": 250
    }
}
