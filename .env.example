# Secrets for runs pointed at a paid model API. Copy to .env, which is
# git-ignored, and fill in the keys you actually use:
#
#   cp .env.example .env
#
# Read by analysis/topic_labeling.py for the one variable --api-key-env names
# (set it in the [model] table of analysis/topic-labeling.toml), and only when
# that variable is absent from the environment -- so an exported variable or a
# CI secret still wins over this file without editing it.
#
# Values are literal: no interpolation, and an unquoted '#' is part of the
# secret rather than the start of a comment. Quote a value to keep leading or
# trailing spaces.

FIREWORKS_API_KEY=
# OPENAI_API_KEY=
# TOGETHER_API_KEY=
